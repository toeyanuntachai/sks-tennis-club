SKS_ORIGIN=http://127.0.0.1:4317
SKS_PORT=4317
SKS_BIND_ADDRESS=127.0.0.1
SKS_DATABASE_PATH=./data/sks.sqlite
LINE_LOGIN_CHANNEL_ID=
LINE_LIFF_ID=
# Comma-separated permanent member IDs; never nicknames or email addresses.
SKS_ADMIN_MEMBER_IDS=
# Optional OA notifications: created once and full once per event, to this group only.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_NOTIFY_GROUP_ID=
# Generate privately with: node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
SKS_INVITE_CODE=
# Optional ALM booking automation. Keep both flags 0 until supervised verification.
ALM_BOOKING_ENABLED=0
ALM_BOOKING_VERIFIED=0
# Maximum total THB for the complete multi-court checkout; required before preview/enable.
ALM_MAX_TOTAL_BAHT=
# Defaults to alm-session.json beside SKS_DATABASE_PATH (/data on Railway).
ALM_SESSION_PATH=
